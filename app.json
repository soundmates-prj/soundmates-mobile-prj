{
  "expo": {
    "name": "SoundMate",
    "slug": "SoundMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_notext.png",
    "scheme": "soundmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0D0D0D",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/logo_notext.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0D0D0D",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/logo_notext.png",
      "backgroundColor": "#0D0D0D"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phep SoundMate truy cap thu vien anh de cap nhat anh dai dien va anh bia.",
          "cameraPermission": "Cho phep SoundMate su dung camera de chup anh dai dien va anh bia.",
          "microphonePermission": "Cho phep SoundMate su dung microphone khi quay video tu camera."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_notext.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Cho phep SoundMate su dung microphone.",
          "ios": {
            "audioSessionCategory": "Playback"
          },
          "android": {
            "stayAwake": true
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
